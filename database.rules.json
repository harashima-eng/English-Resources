{
  "rules": {
    "exams": {
      "$examId": {
        ".read": true,
        ".write": "auth != null && auth.token.email === 'harashima@komagome.ed.jp'",
        "connectedStudents": {
          "$pushId": {
            ".write": "newData.val() === true || newData.val() === null"
          }
        }
      }
    },
    "answers": {
      "$examId": {
        ".read": true,
        ".write": "auth != null && auth.token.email === 'harashima@komagome.ed.jp'"
      }
    },
    "responses": {
      "$examId": {
        ".read": "auth != null && auth.token.email === 'harashima@komagome.ed.jp'",
        ".write": "auth != null && auth.token.email === 'harashima@komagome.ed.jp'",
        "$questionKey": {
          "$deviceId": {
            ".write": "newData.hasChildren(['answer', 'timestamp']) && newData.child('answer').isString() && newData.child('answer').val().length < 20",
            ".validate": "newData.hasChildren(['answer', 'timestamp']) && !newData.hasChild('extra')"
          }
        }
      }
    },
    "leaderboard": {
      "$examId": {
        ".read": true,
        ".write": "auth != null && auth.token.email === 'harashima@komagome.ed.jp'",
        "$deviceId": {
          ".write": "newData.hasChildren(['name', 'score', 'timestamp'])",
          ".validate": "newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 12 && newData.child('score').isNumber()"
        }
      }
    },
    "reveal-sessions": {
      "$examId": {
        ".read": true,
        "active": {
          ".write": "auth != null && auth.token.email === 'harashima@komagome.ed.jp'",
          ".validate": "newData.isBoolean() || !newData.exists()"
        },
        "name": {
          ".write": "auth != null && auth.token.email === 'harashima@komagome.ed.jp'",
          ".validate": "newData.isString() || !newData.exists()"
        },
        "startedAt": {
          ".write": "auth != null && auth.token.email === 'harashima@komagome.ed.jp'",
          ".validate": "newData.isNumber() || !newData.exists()"
        },
        "teacherEmail": {
          ".write": "auth != null && auth.token.email === 'harashima@komagome.ed.jp'",
          ".validate": "newData.isString() || !newData.exists()"
        },
        "reveals": {
          ".write": "auth != null && auth.token.email === 'harashima@komagome.ed.jp'",
          "$qkey": {
            ".validate": "newData.isBoolean() || !newData.exists()"
          }
        },
        "presence": {
          "$deviceId": {
            ".write": "newData.val() === null || (newData.hasChildren(['joinedAt']) && newData.child('joinedAt').isNumber())"
          }
        },
        "responses": {
          "$qkey": {
            "$deviceId": {
              ".write": "newData.val() === null || (newData.hasChildren(['type', 'timestamp']) && newData.child('type').isString() && newData.child('timestamp').isNumber())"
            }
          }
        }
      }
    },
    "errors": {
      ".read": "auth != null && auth.token.email === 'harashima@komagome.ed.jp'",
      "$errorId": {
        ".write": true,
        ".validate": "newData.hasChildren(['msg', 'ts']) && newData.child('msg').isString() && newData.child('msg').val().length < 500"
      }
    },
    "bug-reports": {
      ".read": "auth != null && auth.token.email === 'harashima@komagome.ed.jp'",
      "$reportId": {
        ".write": true,
        ".validate": "newData.hasChildren(['type', 'ts', 'deviceId']) && newData.child('type').isString() && newData.child('type').val().length < 50"
      }
    },
    "triage": {
      ".read": "auth != null && auth.token.email === 'harashima@komagome.ed.jp'",
      ".write": "auth != null && auth.token.email === 'harashima@komagome.ed.jp'"
    },
    "eiken-folders": {
      ".read": "auth != null && auth.token.email.endsWith('@komagome.ed.jp')",
      ".write": "auth != null && auth.token.email === 'harashima@komagome.ed.jp'"
    },
    "eiken-assignments": {
      ".read": "auth != null && auth.token.email.endsWith('@komagome.ed.jp')",
      ".write": "auth != null && auth.token.email === 'harashima@komagome.ed.jp'"
    },
    "eiken-submissions": {
      "$assignmentId": {
        ".read": "auth != null && auth.token.email === 'harashima@komagome.ed.jp'",
        "$sanitizedEmail": {
          ".read": "auth != null && auth.token.email != null",
          ".write": "auth != null && (!data.exists() || (data.exists() && !data.child('correction').exists() && data.child('studentEmail').val() === auth.token.email))",
          "correction": {
            ".write": "auth != null && auth.token.email === 'harashima@komagome.ed.jp'"
          }
        }
      }
    }
  }
}
